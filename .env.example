# ============================================================
# HealthTrack AI – ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayın:  cp .env.example .env
# .env dosyası Git'e EKLENMEZ.
# ============================================================

# development | demo | production
ENVIRONMENT=demo
APP_PORT=8080

# JWT imzalama anahtarı: uzun ve rastgele olmalı (ör. `openssl rand -hex 32`)
JWT_SECRET=change-me-in-env-please-use-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Yerel HTTP demoda false; HTTPS üretim ortamında MUTLAKA true
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# İlk yönetici hesabı (yalnızca hesap yoksa oluşturulur)
ADMIN_EMAIL=admin@healthtrack.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin.Demo2026

# Demo kullanıcılar ve sentetik veriler (production ortamında oluşturulmaz)
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=Demo.User2026

# Yapay zekâ (isteğe bağlı). Boş bırakılırsa asistan yedek modda çalışır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Yüklenebilecek en büyük dosya (MB)
MAX_UPLOAD_MB=10

# Frontend farklı bir origin'den çalışacaksa (ör. Vite dev sunucusu) virgülle ayırın
CORS_ORIGINS=

# Debian paket deposuna erişim yoksa false yapın (görsel OCR devre dışı kalır)
INSTALL_OCR=true
